# PostgreSQL
DATABASE_URL=postgresql://pothole:pothole@localhost:5432/pothole_db
RUN_MIGRATIONS_ON_STARTUP=true

# JWT
# Pri reálnom nasadení použite dlhú náhodnú hodnotu.
JWT_SECRET=replace-with-random-secret
JWT_EXPIRES_SECONDS=3600

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://ct-zadanie2.vercel.app

# Nahrávanie
# 25 MB
MAX_UPLOAD_BYTES=26214400

# AWS prihlasovacie údaje používané knižnicou boto3.
# V Azure App Service / Render ich nastavte ako bezpečné premenné prostredia.
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_REGION=eu-central-1

# Súkromný S3 bucket pre originálne nahrané obrázky.
S3_BUCKET=your-private-pothole-images-bucket
S3_PRESIGN_SECONDS=3600

# Súkromná AWS Lambda funkcia volaná cez boto3.
LAMBDA_FUNCTION_NAME=your-pothole-yolov8-lambda-name
